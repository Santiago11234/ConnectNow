OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o-mini
DATABASE_URL=sqlite:///./data/connectnow.db

# Where the frontend looks for the API. Unset locally, which falls back to
# http://localhost:8000. On a deploy using vercel.json's service rewrites the
# backend is reachable at the rewrite path, so set:
#   NEXT_PUBLIC_API_URL=/api/backend
NEXT_PUBLIC_API_URL=
